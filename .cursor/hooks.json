{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard.py shell",
        "failClosed": true,
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 .cursor/hooks/guard.py mcp",
        "failClosed": true,
        "timeout": 15
      }
    ]
  }
}
